# Configuración de las pantallas. Copia este archivo como apps/frontend/.env.local.
# Todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador: nunca pongas contraseñas ni claves aquí.

# Dirección del backend. Para usar el sistema desde otras PCs, pon la IP de la PC servidor
# (p. ej. http://IP-DEL-SERVIDOR:4000) y reserva esa IP en el router para que no cambie.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Agente de impresión de cada caja (opcional; este es el valor por defecto).
NEXT_PUBLIC_PRINT_AGENT_URL=http://127.0.0.1:17777

# Subida de imágenes a Cloudinary (opcional). Usa un "upload preset" sin firma y restringido
# (solo imágenes, tamaño máximo) desde el panel de Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
