# Motores para `npm run verificar`. Copiar como .env.verificar (no se sube al repositorio).
# Cada motor se prueba solo si tiene HOST. El usuario debe poder crear y borrar bases:
# la verificación crea una base temporal tmp_verificar_<número> y la borra al terminar.
# No toca ninguna otra base.

# MariaDB / MySQL local (xampp)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_SSL_MODE=DISABLED

# SQL Server (servidor\INSTANCIA o servidor con puerto)
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_SSL_MODE=DISABLED

# MySQL 8 en la nube (Aiven): SSL obligatorio, CA relativo a la raíz del proyecto
MYSQL8_HOST=
MYSQL8_PORT=3306
MYSQL8_USER=
MYSQL8_PASSWORD=
MYSQL8_SSL_MODE=REQUIRED
MYSQL8_SSL_CA_PATH=
